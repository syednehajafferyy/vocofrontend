# ==========================================
# VOCO Rooftop Restaurant - Frontend Env
# ==========================================

# 1. Admin Authentication for Frontend Dashboard (/admin-login)
# Used to verify credentials and issue secure session cookies for admin actions
ADMIN_EMAIL="admin@vocorooftop.com"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"

# 2. Backend REST API URL
# For Local Development:
# NEXT_PUBLIC_API_URL="http://localhost:5000"
# API_URL="http://localhost:5000"
#
# For Production on Vercel:
# Set this to your deployed backend URL on Vercel (without trailing slash)
# Example: https://voco-backend.vercel.app
NEXT_PUBLIC_API_URL="https://your-backend-project.vercel.app"
API_URL="https://your-backend-project.vercel.app"
